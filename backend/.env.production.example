NODE_ENV=production
PORT=5001

# Use your final live domain here. Include both apex and www if both will open the app.
CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/chatter?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-long-random-secret

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
